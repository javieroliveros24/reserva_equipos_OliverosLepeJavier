# Copia este archivo como .env y pon tus propios valores.
# El .env de verdad NO se sube al repositorio (está en .gitignore).

PORT=3000
NODE_ENV=development
DEBUG=false

# Mínimo 32 caracteres. Inventa uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Solo pon true si la aplicación está detrás de un proxy de confianza (Nginx, Render...)
TRUST_PROXY=false
