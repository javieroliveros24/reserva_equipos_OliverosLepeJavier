<%- include('../parciales/cabecera', { titulo }) %>

<%- include('../parciales/errores', { errores }) %>

<%# No hay campo de rol: todas las cuentas nuevas son "usuario". %>
<form method="post" action="/registro" class="tarjeta formulario">
  <label for="nombre">Nombre</label>
  <input type="text" id="nombre" name="nombre" value="<%= valores.nombre %>" minlength="2" maxlength="80" required autocomplete="name">

  <label for="email">Correo electrónico</label>
  <input type="email" id="email" name="email" value="<%= valores.email %>" maxlength="254" required autocomplete="email">

  <label for="password">Contraseña (mínimo 8 caracteres)</label>
  <input type="password" id="password" name="password" minlength="8" maxlength="200" required autocomplete="new-password">

  <button type="submit">Crear cuenta</button>
</form>

<p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>.</p>

<%- include('../parciales/pie') %>
